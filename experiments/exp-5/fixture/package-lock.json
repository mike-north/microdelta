{
  "name": "@microdelta/exp5-fixture-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@microdelta/exp5-fixture-workspace",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@microdelta/exp5-consumer": {
      "resolved": "packages/consumer",
      "link": true
    },
    "node_modules/@microdelta/exp5-producer": {
      "resolved": "packages/producer",
      "link": true
    },
    "packages/consumer": {
      "name": "@microdelta/exp5-consumer",
      "version": "0.0.0",
      "dependencies": {
        "@microdelta/exp5-producer": "0.0.0"
      }
    },
    "packages/producer": {
      "name": "@microdelta/exp5-producer",
      "version": "0.0.0"
    }
  }
}
