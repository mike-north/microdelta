{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "mainEntryPointFilePath": "<projectFolder>/dist/src/index.d.ts",
  "compiler": { "tsconfigFilePath": "<projectFolder>/tsconfig.api.json" },
  "apiReport": { "enabled": false },
  "docModel": { "enabled": true, "apiJsonFilePath": "<projectFolder>/dist/consumer.api.json" },
  "dtsRollup": {
    "enabled": true,
    "untrimmedFilePath": "<projectFolder>/dist/api/consumer.untrimmed.d.ts",
    "alphaTrimmedFilePath": "<projectFolder>/dist/api/consumer.alpha.d.ts",
    "betaTrimmedFilePath": "<projectFolder>/dist/api/consumer.beta.d.ts",
    "publicTrimmedFilePath": "<projectFolder>/dist/api/consumer.public.d.ts"
  },
  "messages": { "extractorMessageReporting": {
    "ae-missing-release-tag": { "logLevel": "error", "addToApiReportFile": false },
    "ae-internal-missing-underscore": { "logLevel": "error", "addToApiReportFile": false },
    "ae-incompatible-release-tags": { "logLevel": "error", "addToApiReportFile": false }
  } }
}
