ContextMap ExperimentMap {
  type = SYSTEM_LANDSCAPE
  state = TO_BE
  contains ProducerContext
  contains ConsumerContext
}

BoundedContext ProducerContext {
  type = FEATURE
  Aggregate Records {
    Entity RecordEntity {
      aggregateRoot
      String id
      String label
      def String rename(String nextLabel);
      def package String _localCode(String prefix);
    }
  }
}

BoundedContext ConsumerContext {
  type = APPLICATION
  Aggregate Reports {
    Service ReportService {
      String formatRecord(RecordEntity record);
    }
  }
}
