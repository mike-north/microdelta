{
  "name": "microdelta",
  "version": "0.1.0",
  "description": "Persisted incremental analysis; implementation in progress",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-north/microdelta.git",
    "directory": "packages/core"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/api/microdelta.public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api/microdelta.public.d.ts",
      "import": "./dist/src/index.js"
    },
    "./conformance/store": {
      "types": "./dist/api/microdelta.conformance.store.public.d.ts",
      "import": "./dist/test/conformance/store/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/api-temp"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && api-extractor run --config api-extractor.json && api-extractor run --config api-extractor-conformance.json && node ../../tooling/trim-declaration-imports.mjs dist/api/microdelta.beta.d.ts dist/api/microdelta.public.d.ts",
    "check": "concurrently --success all --names types,lint \"npm run check:types\" \"npm run check:lint\"",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "check:lint": "eslint .",
    "test": "npm run test:unit && npm run test:types && npm run test:controls",
    "test:unit": "tsc -p tsconfig.test.json && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.mjs --runInBand",
    "test:types": "tsd",
    "test:controls": "node --test test/durable-history/controls/control-outcome.test.mjs test/acceptance/controls/paths.test.mjs"
  },
  "tsd": {
    "directory": "test-d",
    "compilerOptions": {
      "paths": {}
    }
  },
  "dependencies": {
    "@microdelta/definition": "0.1.0",
    "@microdelta/history": "0.1.0",
    "@microdelta/machine-node": "0.1.0",
    "@microdelta/materialization": "0.1.0",
    "@microdelta/resolution": "0.1.0",
    "@microdelta/supervision": "0.1.0",
    "@microdelta/tracking": "0.1.0",
    "@microdelta/value": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
