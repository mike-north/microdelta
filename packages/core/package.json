{
  "name": "microdelta",
  "version": "0.0.0",
  "private": true,
  "description": "Persisted incremental analysis; implementation in progress",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/api/microdelta.public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api/microdelta.public.d.ts",
      "import": "./dist/src/index.js"
    },
    "./conformance/store": {
      "types": "./dist/api/microdelta.conformance.store.public.d.ts",
      "import": "./dist/test/conformance/store/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && api-extractor run --config api-extractor.json && api-extractor run --config api-extractor-conformance.json",
    "check": "concurrently --success all --names types,lint \"npm run check:types\" \"npm run check:lint\"",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "check:lint": "eslint .",
    "test": "npm run test:unit && npm run test:types && npm run test:controls",
    "test:unit": "tsc -p tsconfig.test.json && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.mjs --runInBand",
    "test:types": "tsd",
    "test:controls": "node --test test/durable-history/controls/control-outcome.test.mjs"
  },
  "tsd": {
    "directory": "test-d"
  },
  "dependencies": {
    "@microdelta/history": "0.0.0",
    "@microdelta/machine-node": "0.0.0",
    "@microdelta/tracking": "0.0.0",
    "@microdelta/value": "0.0.0"
  }
}
