{
  "name": "microdelta",
  "version": "0.0.0",
  "private": true,
  "description": "Persisted incremental analysis; implementation in progress",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./conformance/store": {
      "types": "./dist/test/conformance/store/index.d.ts",
      "import": "./dist/test/conformance/store/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "concurrently --success all --names types,lint \"npm run check:types\" \"npm run check:lint\"",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "check:lint": "eslint .",
    "test": "npm run test:unit && npm run test:types",
    "test:unit": "tsc -p tsconfig.test.json && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand",
    "test:types": "npm run build && tsd"
  },
  "tsd": {
    "directory": "test-d"
  },
  "peerDependencies": {
    "@jest/globals": "^30.5.1"
  },
  "peerDependenciesMeta": {
    "@jest/globals": {
      "optional": true
    }
  },
  "dependencies": {
    "@preact/signals-core": "1.14.4"
  }
}
