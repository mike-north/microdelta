{
  "name": "@microdelta/machine-node",
  "version": "0.1.0",
  "description": "Node implementation of microdelta host capabilities",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-north/microdelta.git",
    "directory": "packages/machine-node"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/api/machine-node.public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api/machine-node.public.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/api-temp"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && api-extractor run --config api-extractor.json",
    "check": "concurrently --success all --names types,lint \"npm run check:types\" \"npm run check:lint\"",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "check:lint": "eslint .",
    "test": "npm run test:unit && npm run test:types",
    "test:unit": "tsc -p tsconfig.test.json && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.mjs --runInBand",
    "test:types": "tsd"
  },
  "tsd": {
    "directory": "test-d"
  },
  "dependencies": {
    "@microdelta/machine": "0.1.0",
    "better-sqlite3": "12.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
