{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "mainEntryPointFilePath": "<projectFolder>/dist/src/index.d.ts",
  "apiReport": {
    "enabled": true,
    "reportFileName": "tracking",
    "reportFolder": "<projectFolder>/etc",
    "reportTempFolder": "<projectFolder>/dist/api-temp"
  },
  "dtsRollup": {
    "enabled": true,
    "untrimmedFilePath": "<projectFolder>/dist/api/tracking.untrimmed.d.ts",
    "alphaTrimmedFilePath": "<projectFolder>/dist/api/tracking.alpha.d.ts",
    "betaTrimmedFilePath": "<projectFolder>/dist/api/tracking.beta.d.ts",
    "publicTrimmedFilePath": "<projectFolder>/dist/api/tracking.public.d.ts"
  },
  "messages": {
    "extractorMessageReporting": {
      "ae-missing-release-tag": {
        "logLevel": "error",
        "addToApiReportFile": false
      },
      "ae-internal-missing-underscore": {
        "logLevel": "error",
        "addToApiReportFile": false
      },
      "ae-incompatible-release-tags": {
        "logLevel": "error",
        "addToApiReportFile": false
      }
    }
  },
  "docModel": {
    "enabled": false
  },
  "newlineKind": "lf"
}
