{
  "name": "@microdelta/tracking",
  "version": "0.2.1",
  "description": "Existing tracking context capability; implementation incomplete",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-north/microdelta.git",
    "directory": "packages/tracking"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/api/tracking.public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api/tracking.public.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/api-temp"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && api-extractor run --config api-extractor.json",
    "check": "concurrently --success all --names types,lint \"npm run check:types\" \"npm run check:lint\"",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.portable.json",
    "check:lint": "eslint .",
    "test": "npm run test:unit && npm run test:controls && npm run test:types",
    "test:unit": "tsc -p tsconfig.test.json && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand",
    "test:controls": "tsc -p tsconfig.test.json && node --test test/controls/control-outcome.test.mjs && node test/controls/lazy-view-controls.mjs",
    "test:types": "tsd"
  },
  "tsd": {
    "directory": "test-d"
  },
  "dependencies": {
    "@microdelta/machine": "0.2.0",
    "@microdelta/value": "0.1.1",
    "@preact/signals-core": "1.14.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
