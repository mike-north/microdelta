+        expect(statuses(result.value.members)).toEqual({ 'pr-1': 'succeeded', 'pr-2': 'succeeded', 'pr-3': 'succeeded' });
+        expect(result.waitingUntil).toBeUndefined();
+        expect(received('pr-1')).toHaveLength(2);
